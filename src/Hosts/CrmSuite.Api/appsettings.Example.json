{
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "MySql": "Server=localhost;Port=3306;Database=crm_suite;User=YOUR_USER;Password=YOUR_PASSWORD;CharSet=utf8mb4;AllowUserVariables=True;UseAffectedRows=False;"
  },
  "Database": {
    "ServerVersion": "8.0.36",
    "EnableDetailedErrors": false,
    "EnableSensitiveDataLogging": false
  },
  "Identity": {
    "SeedOnStartup": true
  },
  "Jwt": {
    "Issuer": "CrmSuite",
    "Audience": "CrmSuite.Clients",
    "Key": "CHANGE_ME_WITH_A_RANDOM_32_BYTE_KEY",
    "AccessTokenMinutes": 60,
    "RefreshTokenDays": 30,
    "RequireHttpsMetadata": true
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:5173",
      "https://localhost:5173",
      "http://127.0.0.1:5173",
      "https://127.0.0.1:5173"
    ]
  },
  "Http": {
    "UseHttpsRedirection": true
  },
  "Swagger": {
    "Enabled": false
  },
  "Hangfire": {
    "Enabled": true,
    "DashboardPath": "/hangfire",
    "TablesPrefix": "hangfire",
    "PrepareSchema": true,
    "WorkerCount": 4
  },
  "HealthChecks": {
    "MySql": {
      "Enabled": true
    }
  },
  "Settings": {
    "EncryptionKey": "CHANGE_ME_WITH_A_RANDOM_32_BYTE_ENCRYPTION_KEY"
  },
  "Saman": {
    "Enabled": false,
    "IsSandbox": true,
    "BaseUrl": "https://sep.shaparak.ir",
    "MerchantId": "",
    "TerminalId": "",
    "CallbackUrl": "",
    "RequestPath": "/onlinepg/onlinepg",
    "VerifyPath": "/Verify"
  },
  "Sms": {
    "Provider": "Log",
    "BaseUrl": "",
    "ApiKey": "",
    "Sender": ""
  },
  "Bale": {
    "Enabled": false,
    "ApiBaseUrl": "https://tapi.bale.ai",
    "BotToken": ""
  },
  "Otp": {
    "Length": 6,
    "TtlSeconds": 120,
    "MaxAttempts": 5,
    "ResendDelaySeconds": 60
  },
  "Storage": {
    "RootPath": "storage",
    "PublicBaseUrl": "",
    "MaxFileSizeMb": 10,
    "AllowedExtensions": [
      ".pdf",
      ".jpg",
      ".jpeg",
      ".png",
      ".zip"
    ]
  },
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console",
      "Serilog.Sinks.File"
    ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System": "Warning",
        "Hangfire": "Information"
      }
    },
    "Enrich": [
      "FromLogContext",
      "WithMachineName",
      "WithEnvironmentName"
    ],
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:yyyy-MM-dd HH:mm:ss} {Level:u3}] {Message:lj} {Properties:j}{NewLine}{Exception}"
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/crm-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 30,
          "shared": true,
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{Level:u3}] [{TraceId}] {Message:lj}{NewLine}{Exception}"
        }
      }
    ],
    "Properties": {
      "Application": "CrmSuite.Api"
    }
  }
}
